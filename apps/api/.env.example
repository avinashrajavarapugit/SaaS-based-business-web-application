# Copy to apps/api/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Connect as the unprivileged saas_app role, never the superuser: superusers
# bypass row-level security, which silently disables tenant isolation.
DATABASE_URL=postgresql://saas_app:saas_app@localhost:5432/saas_dev

# Origin allowed by CORS — the Vite dev server.
WEB_ORIGIN=http://localhost:5173

# At least 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Mailpit (see docker-compose.yml) catches all outbound mail in development.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@ransack.local
