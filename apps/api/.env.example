# Copy to apps/api/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Local Postgres (see docker-compose.yml) or a Neon free-tier connection string.
DATABASE_URL=postgresql://saas:saas@localhost:5432/saas_dev

# Origin allowed by CORS — the Vite dev server.
WEB_ORIGIN=http://localhost:5173
