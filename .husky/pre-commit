#!/bin/sh
# The machine's global git identity is a work address. A fresh clone has no
# repo-local override, so without this guard those commits would land silently.

email=$(git config user.email)

case "$email" in
  *@microsoft.com | *.microsoft.com)
    cat >&2 <<EOF

  Refusing to commit as $email in a personal repository.

  Fix with:
    git config user.email "179114570+avinashrajavarapugit@users.noreply.github.com"
    git config user.name  "Avinash Rajavarapu"

EOF
    exit 1
    ;;
  '')
    echo "error: no git user.email configured for this repository." >&2
    exit 1
    ;;
esac

pnpm lint-staged
